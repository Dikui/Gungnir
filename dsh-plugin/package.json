{
  "name": "dk-gungnir",
  "version": "4.5.15",
  "description": "Gungnir 简体中文技能的 DeepSeek Harness 插件包，保留技能原名。",
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "cordis.patch.yml", "LICENSE", "README.md", "skills"],
  "engines": { "node": "^22.19.0 || >=24" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/Dikui/Gungnir.git", "directory": "dsh-plugin" },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "dependencies": { "yaml": "^2.4.2" },
  "scripts": {
    "build": "node scripts/copy-skills.mjs",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "version:check": "node ../scripts/check-repo.mjs",
    "prepack": "npm run version:check && npm run build && npm test && npm run verify && node scripts/package-license.mjs prepare",
    "postpack": "node scripts/package-license.mjs clean"
  }
}
