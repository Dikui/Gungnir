#!/bin/bash
# gungnir-hook
# Blocks risky pushes: deletes, force pushes, protected branches, scan findings.
# bash 3.2, Git and POSIX utilities only.
dir=$(cd "$(dirname "$0")" && pwd) || exit 2
scan="$dir/lib/scan.sh"
remote=${1:-}
root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 1
cd "$root" || exit 1
zero=0000000000000000000000000000000000000000
status=0
reject() { printf 'pre-push: rejected %s: %s\n' "$1" "$2" >&2; status=1; }

# Branch names registered in the safe-push-protected block, one per line.
protected() {
    [ -f docs/agents/push-rules.md ] || return 1
    awk -v b="$1" '
        $0=="```safe-push-protected" { on=1; next }
        $0=="```" { on=0; next }
        on {
            s=$0; sub(/^[ \t]+/,"",s); sub(/[ \t\r]+$/,"",s)
            if (s=="" || substr(s,1,1)=="#") next
            if (s==b) found=1
        }
        END { exit !found }
    ' docs/agents/push-rules.md
}

if [ ! -f "$scan" ]; then
    printf '%s\n' 'pre-push: scanner missing (.githooks/lib/scan.sh); rerun install.sh' >&2
    exit 1
fi
if [ -z "$remote" ]; then
    printf '%s\n' 'pre-push: remote name missing' >&2
    exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$remote_ref" ] || continue
    case "$remote_ref" in
        refs/heads/*) ;;
        *) printf 'pre-push: %s is not a branch; not checked\n' "$remote_ref" >&2; continue ;;
    esac
    branch=${remote_ref#refs/heads/}
    if [ "$local_sha" = "$zero" ]; then reject "$branch" 'deleting a remote branch is not allowed'; continue; fi
    if protected "$branch"; then reject "$branch" 'branch is registered in safe-push-protected'; continue; fi
    if [ "$remote_sha" != "$zero" ]; then
        if ! git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
            reject "$branch" 'remote commit is not available locally; fetch first'; continue
        fi
        if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            reject "$branch" 'non-fast-forward (force push); fetch first'; continue
        fi
    fi
    head=$(git rev-parse --verify HEAD 2>/dev/null) || head=
    if [ "$local_sha" != "$head" ]; then
        reject "$branch" 'only pushing the current HEAD is supported'; continue
    fi
    if [ "$remote_sha" = "$zero" ]; then
        output=$(bash "$scan" --unpushed --remote "$remote" --target "$branch" 2>&1 < /dev/null)
    else
        output=$(bash "$scan" --unpushed --base "$remote_sha" --remote "$remote" --target "$branch" 2>&1 < /dev/null)
    fi
    code=$?
    [ -z "$output" ] || printf '%s\n' "$output" >&2
    if [ "$code" -ne 0 ]; then
        reject "$branch" "scan exit code $code. Run /safe-push to see details."
    fi
done
exit "$status"
