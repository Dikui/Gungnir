#!/bin/bash
# gungnir-hook
# Blocks commits whose staged changes fail the safe-push scanner.
# bash 3.2, Git and POSIX utilities only.
dir=$(cd "$(dirname "$0")" && pwd) || exit 2
scan="$dir/lib/scan.sh"
if [ ! -f "$scan" ]; then
    printf '%s\n' 'pre-commit: scanner missing (.githooks/lib/scan.sh); rerun install.sh' >&2
    exit 1
fi
output=$(bash "$scan" --staged 2>&1 < /dev/null)
code=$?
case "$code" in
    0)
        [ -z "$output" ] || printf '%s\n' "$output" >&2
        exit 0 ;;
    *)
        [ -z "$output" ] || printf '%s\n' "$output" >&2
        printf '%s\n' "pre-commit: commit rejected (scan exit code $code). Run /safe-push to see details." >&2
        exit 1 ;;
esac
