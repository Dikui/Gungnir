btext=re.search(r'\\"'$ node scripts/audit-english.mjs '"\\(cwd: \\.\\)\\n(.*?)exit-code:',(ev/'baseline.txt').read_text(),re.S)[1]
b=findings(btext);h=findings((ev/'rework1-committed-baseline.txt').read_text());f=findings(p.stdout)
paths={path for path,line in b};assert collections.Counter({key:count for key,count in f.items() if key[0] in paths})==b
hc=collections.Counter(path for path,line in h.elements());fc=collections.Counter(path for path,line in f.elements());assert hc==fc
summary=f'原基线：{sum(b.values())} 条；提交版本：{sum(h.values())} 条；返工最终：{sum(f.values())} 条。\\n原基线路径及问题行内容（忽略行号）：完全相同，新增 0。\\n与提交版本对比：各文件提示行数相同，新增提示行 0。\\n旧走查引用因行号与计数解释变化，部分提示行内容变化；新场景与本次报告没有新增提示行。\\n原基线及提交版本、返工最终审计退出码均为 1。\\n提交后才进入扫描范围的文件与提示数：\\n'
for path in sorted(set(fc)-paths):summary+=f'{path}: {fc[path]}\\n'
(ev/'rework1-audit-comparison.txt').write_text(summary)
expected={'docs/engineering/wayfinder.md','docs/productivity/grilling.md','docs/tasks/003-progress/evidence/walkthrough.md','docs/tasks/003-progress/report.md','skills/engineering/wayfinder/SKILL.md','skills/productivity/grilling/SKILL.md'}
p=subprocess.run(['git','diff','--name-only'],capture_output=True,text=True);assert set(p.stdout.splitlines())==expected
head_report=subprocess.run(['git','show','HEAD:docs/tasks/003-progress/report.md'],capture_output=True,text=True,check=True).stdout
assert (root/'docs/tasks/003-progress/report.md').read_text().startswith(head_report)
