p=subprocess.run(['git','diff'],capture_output=True,text=True)
(ev/'rework1-diff.txt').write_text('"'$ git diff'"\\n'+p.stdout+f'exit-code: {p.returncode}\\n')
log=''
for argv in [['git','diff','--stat'],['git','diff','--numstat','--','skills/productivity/grilling/SKILL.md','skills/engineering/wayfinder/SKILL.md'],['wc','-l','skills/productivity/grilling/SKILL.md','skills/engineering/wayfinder/SKILL.md'],['git','diff','--check']]:
    p=subprocess.run(argv,capture_output=True,text=True);assert p.returncode==0
    log+='"'$ '"'+' '.join(argv)+'\\n'+p.stdout+p.stderr+f'exit-code: {p.returncode}\\n\\n'
    if '--numstat' in argv:
        for line in p.stdout.splitlines():
            added,deleted,file=line.split('\\t');assert int(added)-int(deleted)==2
(ev/'rework1-change-size.txt').write_text(log)
(ev/'rework1-final-status.txt').touch();(ev/'rework1-final-scope.txt').touch()
p=subprocess.run(['git','status','--short','--untracked-files=all'],capture_output=True,text=True)
(ev/'rework1-final-status.txt').write_text('"'$ git status --short --untracked-files=all'"\\n'+p.stdout+f'exit-code: {p.returncode}\\n')
def statuses(s):return {line for line in s.splitlines() if line.startswith((' M ','?? ','M  ','A  '))}
initial=statuses((ev/'rework1-initial-status.txt').read_text());final=statuses(p.stdout)
assert not(initial-final)
for line in final-initial:
