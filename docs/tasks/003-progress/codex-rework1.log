/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
import subprocess,tempfile,os,shutil,tarfile,io
root=Path.cwd();ev=root/'docs/tasks/003-progress/evidence';tmp=Path(tempfile.mkdtemp(prefix='gungnir-rework1-audit-',dir='/private/tmp'))
archive=subprocess.run(['git','archive','HEAD'],capture_output=True,check=True).stdout
with tarfile.open(fileobj=io.BytesIO(archive)) as tar:
    for member in tar.getmembers():
        if member.isfile() and (member.name.endswith('.md') or member.name=='scripts/audit-english.mjs'):
            target=tmp/member.name;target.parent.mkdir(parents=True,exist_ok=True);target.write_bytes(tar.extractfile(member).read())
env=os.environ.copy();env['GIT_DIR']=str(root/'.git');env['GIT_WORK_TREE']=str(tmp)
p=subprocess.run(['node','scripts/audit-english.mjs'],cwd=tmp,env=env,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,text=True)
(ev/'rework1-committed-baseline.txt').write_text('"'$ git archive HEAD（仅读取已提交文件，临时目录执行原审计）'"\\n"'$ node scripts/audit-english.mjs'"\\n'+p.stdout+f'exit-code: {p.returncode}\\n')
shutil.rmtree(tmp)
print('提交版本英文审计退出码:',p.returncode,'；临时目录已删除。')
p=ev/'walkthrough.md';s=p.read_text().replace('[rework1-skill-lines.txt](rework1-skill-lines.txt)','[当前行号快照](rework1-skill-lines.txt)').replace('[skill-lines.txt](skill-lines.txt)','[原版快照](skill-lines.txt)')
# 新增场景的每条引用独立列出，保持中文说明易读。
head,tail=s.split('\\n## h.',1)
lines=[]
for line in tail.splitlines():
    if line.startswith('依据：'):
        lines.append('依据：');lines.append('')
        for clause in line[3:].split('；'):lines.append('- '+clause)
    else:lines.append(line)
p.write_text(head+'\\n## h.'+'\\n'.join(lines)+'\\n')
print('新增场景引用已分行。')
